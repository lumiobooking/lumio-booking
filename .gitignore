# Dependencies
node_modules/
.pnp
.pnp.js

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.development
.env.production
*.env
!.env.example

# Build output.
#
# These are ANCHORED with a leading slash, or scoped to a workspace, on purpose.
# A bare `build/` matches a directory called "build" at ANY depth, and this repo
# has a source one: apps/web/src/app/api/build/ is the Next.js route that tells
# an open browser tab which deployment is live. It was silently never committed,
# so /api/build returned 404 in production, so the "your tab is running old code"
# check failed every time and swallowed the error — which made every shipped fix
# look like it had not deployed. An ignore rule cost days of that.
#
# Add new build-output paths as anchored or workspace-scoped patterns. Never
# bare.
/dist/
/build/
apps/*/dist/
apps/*/build/
.next/
out/

# Prisma
apps/api/prisma/*.db

# Logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Testing
coverage/

# Misc
.cache/
tmp/

# Built WordPress plugin package (generated)
lumio-booking-*.zip

# Video exports and CapCut output folders (kept on disk, never in git —
# GitHub hard-rejects any file over 100 MB and a push of one clip can
# outweigh the entire source tree).
*.mp4
*.mov
*.mkv
*.avi
0811*/
tsconfig.scoped-check.tsbuildinfo
.dts-check/
