# ===========================================================================
# Lumio Booking API - Environment variables (EXAMPLE)
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# ===========================================================================

# --- Server ---
# Backend API runs on port 8005 (frontend runs on 3005)
PORT=8005
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:3005

# --- Database (PostgreSQL) ---
# Matches docker-compose.yml (host port 5433 -> container 5432)
DATABASE_URL="postgresql://lumio:lumio_dev_password@localhost:5433/lumio_booking?schema=public"

# --- Auth (used from Step 3 onward) ---
# Generate a strong random secret, e.g.: openssl rand -base64 48
JWT_SECRET="change_me_use_a_long_random_secret"
# Comfortable for local dev. In production use a short access token (e.g. 15m).
JWT_ACCESS_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="7d"

# Salt rounds for hashing passwords and API/license keys
BCRYPT_SALT_ROUNDS=12

# --- Notification providers (mock by default, real later) ---
# Options: mock | sendgrid | resend | ses
EMAIL_PROVIDER=mock
# SMS auto-enables Twilio when the TWILIO_* vars below are set. Leave blank to
# auto-detect; set to "mock" to force-disable real SMS.
SMS_PROVIDER=

# Twilio (platform-level, one account for all salons). From the Twilio Console.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# Use ONE sender — a Messaging Service (recommended; handles STOP/HELP) ...
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ... or a single toll-free/long-code number in E.164:
# TWILIO_FROM_NUMBER=+18337195153

# (Email) Real provider keys go here later
# SENDGRID_API_KEY=

# --- Payment provider (mock by default, Stripe later) ---
# Options: mock | stripe
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Redis (queue system, used later) ---
REDIS_URL="redis://localhost:6380"

# --- AI (Claude) — powers auto-written monthly marketing reports, Google-review
#     replies, Messenger & voice assistants. ONE key enables all of them.
#     Get a key at https://console.anthropic.com (Settings -> API keys) and make
#     sure the account has billing/credit. Without it, reports still generate
#     from real numbers (deterministic fallback) — the key just makes the wording
#     more natural. Set this in Render (lumio-api -> Environment), never commit it.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default claude-haiku-4-5-20251001, cheap & fast).
# ANTHROPIC_AGENT_MODEL=claude-haiku-4-5-20251001

# --- Meta / Facebook + Instagram (agency reporting) ---
# System-user token used to pull organic FB Page + IG insights for all salons.
# META_AGENCY_TOKEN=
# Optional: override Graph API version (default v21.0).
# META_GRAPH_VERSION=v21.0

# --- Google Business Profile (agency-wide, powers the Google Maps report) ---
# ONE Google OAuth app (scope business.manage) reads every managed salon's
# Business Profile. Each salon then only needs its Location ID in the app.
# Enable "Business Profile Performance API" in Google Cloud + request API access.
# GBP_AGENCY_CLIENT_ID=
# GBP_AGENCY_CLIENT_SECRET=
# GBP_AGENCY_REFRESH_TOKEN=

# --- TikTok (agency-wide app; organic account reports) ---
# ONE TikTok for Developers app (Login Kit) — key/secret are agency-level; each
# salon stores only its own refresh token (obtained via TikTok OAuth).
# Scopes to request + get approved: user.info.basic, user.info.stats, video.list.
# TIKTOK_AGENCY_CLIENT_KEY=
# TIKTOK_AGENCY_CLIENT_SECRET=

# ---- Trends tab daily feeds (each optional; the tab says which are off) ----
# YouTube Data API v3 key — Google Cloud console → YouTube Data API v3 → Credentials.
YOUTUBE_API_KEY=
# DataForSEO account, for Google Trends rising searches (paid, ~2 calls/day/trade).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Instagram needs no key: it uses each salon's own connected Page/IG account.
