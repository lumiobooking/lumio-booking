{
  "name": "lumio-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Lumio Booking - Multi-tenant SaaS booking platform for nail salons",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api",
    "test": "jest",
    "test:guards": "jest --selectProjects api web --testPathPattern \"(money|phone|sales-guards|market-badge|bootstrap|keepalive|markets|payment-methods|business-hours|sms-policy|esms|salon-clock|opening-bar|booking-rules-dto|thread-ownership|chat-assignment|inbox-view|history-merge|inbox-alerts|push-payload|messenger-access|linked-channels|theme|api-feedback|booking-sources|theme-lint|support-gate|report-docx|agent-fallback|business-persona|voice-lang|lead-memory|content-signals|revenue-signals|schema-guard|region-events|trend-sources|weekly-plan|content-isolation|industry-playbook|promo-playbook|audience-signals|census|industry-coverage|industry-detect)\""
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
