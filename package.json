{
  "name": "lumio-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Lumio Booking - Multi-tenant SaaS booking platform for nail salons",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "db:studio": "npm run db:studio --workspace=apps/api",
    "test": "jest",
    "test:guards": "jest --selectProjects api web --testPathPattern \"(money|phone|sales-guards|market-badge|bootstrap|keepalive|markets|payment-methods|business-hours|sms-policy|esms|salon-clock|opening-bar|booking-rules-dto|thread-ownership|chat-assignment|inbox-view|history-merge|inbox-alerts|push-payload|messenger-access|linked-channels|theme|api-feedback|booking-sources|theme-lint|support-gate|report-docx|agent-fallback|business-persona|voice-lang|lead-memory|content-signals|revenue-signals|i18n-smoke|schema-guard|region-events|trend-sources|weekly-plan|content-isolation|industry-playbook|promo-playbook|audience-signals|census|industry-coverage|industry-detect|health|ads-plan|seo-local|business-profile|site-reader|strategy-brief|shop-location|channel-plan|booking-channel|one-visit|booking-link|market-target|census-audience|self-reschedule|reorder|plain|roadmap|week-key|content-chat|week-outcome|campaign-spec|mobile-dock|social-publish|hook-order|scheduler-wiring|media-retention|social-fit)\"",
    "check:dts": "tsc --emitDeclarationOnly --outDir .dts-check -p apps/api/tsconfig.json 2>&1 | grep -E \"error TS40[0-9][0-9]\" && exit 1 || echo \"no declaration errors\"",
    "test:guards:1": "npm run test:guards -- --shard=1/3",
    "test:guards:2": "npm run test:guards -- --shard=2/3",
    "test:guards:3": "npm run test:guards -- --shard=3/3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
